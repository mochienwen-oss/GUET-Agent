# 所有生成统一使用 deploy/llm-api.json；空 LLM_API_CONFIG_PATH 会报错。
# 生成参数、模型和平台只在该 JSON 中配置，密钥不写入 JSON。
DEEPSEEK_API_KEY=
LLM_API_KEY=
DASHSCOPE_API_KEY=
VOLC_SEARCH_API_KEY=

# 本地启动：以下相对路径以仓库根目录为工作目录。
# QDRANT_PATH 非空时使用本地嵌入式存储，不需要另外启动 Qdrant 服务。
QDRANT_URL=http://localhost:6333
QDRANT_PATH=qdrant_local
QDRANT_COLLECTION=structure_docs_20261019
# 新环境自行导入时使用自己的清单；恢复已有数据时改为与备份配套的清单路径。
ACTIVE_DOCUMENTS_PATH=run/documents.local.json
BM25_VOCAB_PATH=model/bm25_vocab.json

# Embedding 模型
EMBED_MODEL=model/embedding_m3
EMBED_DEVICE=cpu

# 精排模型与设备（本地可使用 CPU）
RERANK_MODEL=model/rerank_m3
RERANK_DEVICE=cpu
RERANK_FP16=0

# MySQL
MYSQL_URL=mysql+pymysql://root:change-this-password@127.0.0.1:33306/guet_chat?charset=utf8mb4

# 管理员种子账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# RAG 检索条数
TOP_K=5

FLOW_EXPAND=1
REF_FOLLOW=1
# 兼容底层检索：显式传入 prev_query 时才拼接上一轮问句。
# 当前聊天由模型读取最近 6 条消息并组织 query，不传 prev_query；此项不控制聊天记忆。
MULTITURN_CARRY=1
