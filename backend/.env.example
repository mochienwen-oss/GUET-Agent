# 所有生成统一使用 deploy/llm-api.json；空 LLM_API_CONFIG_PATH 会报错。
# 生成参数、模型和平台只在该 JSON 中配置，密钥不写入 JSON。
DEEPSEEK_API_KEY=
LLM_API_KEY=
DASHSCOPE_API_KEY=
VOLC_SEARCH_API_KEY=

# Qdrant 向量库
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=D:/guet-agent-微调/qdrant_local
QDRANT_COLLECTION=school_docs

# Embedding 模型
EMBED_MODEL=BAAI/bge-large-zh-v1.5

# 精排模型与设备（本地可使用 CPU）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu

# MySQL
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/guet_chat?charset=utf8mb4

# 管理员种子账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# RAG 检索条数
TOP_K=4

FLOW_EXPAND=1
REF_FOLLOW=1
# 多轮检索接续：把上一轮问句拼进本轮检索（零额外 LLM 调用）。
MULTITURN_CARRY=1
