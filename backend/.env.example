# 所有生成统一使用 deploy/llm-api.json；空 LLM_API_CONFIG_PATH 会报错。
# 生成参数、模型和平台只在该 JSON 中配置，密钥不写入 JSON。
DEEPSEEK_API_KEY=
LLM_API_KEY=
DASHSCOPE_API_KEY=
VOLC_SEARCH_API_KEY=
# 可选：历史 MinerU 资料解析脚本使用，日常问答/PPT 不需要。
MINERU_API_TOKEN=

# Qdrant 向量库
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=D:/guet-agent-微调/qdrant_local
QDRANT_COLLECTION=school_docs

# Embedding 模型
EMBED_MODEL=BAAI/bge-large-zh-v1.5

# 精排模型与设备（本地可使用 CPU）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu

# MySQL
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/guet_chat?charset=utf8mb4

# 管理员种子账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# RAG 检索条数
TOP_K=4

# ── 阶段 2 的三个开关（每个独立、失败开放；默认全开，置 0 回到旧行为）──
# 2a 流程章节完整召回：命中流程/程序章节时按 document_id 补齐同节相邻块。判据见 backend/flows.py
FLOW_EXPAND=1
# 2b 跨文档引用跟随（一跳、≤2 份）。运行时**只读白名单** backend/data/ref_allowlist.json，
#   不跑正则（正则只是离线生成器）。⚠️ 该 json 是**新文件，部署要一起拷**；拷不到自动关闭。
REF_FOLLOW=1
# 2d 多轮检索接续：把上一轮问句拼进本轮检索（零额外 LLM 调用）。
MULTITURN_CARRY=1

# ── 空教室查询：学校统一身份认证凭据（**留空则该工具关闭**）──
# ★ 留空时工具显式返回「未配置」卡片，不是静默给空 —— 配置缺失要**显式**。
# ⚠️ 这是**真实学生账号**，查询以该身份向教务系统发起。凭据只写本地/服务器 .env，
#    **不要提交进仓库**（这两行在仓库里必须保持空值）。
# ⚠️ 该校 CAS 登录**强制验证码**（实测 checkNeedCaptcha 对任意用户名恒返回 isNeed=true），
#    由 `ddddocr` 解 —— 它已在 backend/requirements.txt 里。
JW_STUDENT_ID=
JW_PASSWORD=
# 验证码出错换一张重试的次数。ddddocr 认这套图**大小写不稳**（W/w、J/j、P/p、S/s
# 分不清），单次命中率不到 100%，所以必须重试。
JW_CAPTCHA_RETRIES=4
