# PPT-only independent Doubao Search Custom API. No real key belongs in this file.
VOLC_SEARCH_API_KEY=

# Keep false unless platform-side free-only stopping behavior is actually verified.
# A configured API key or this app's call counter alone cannot guarantee no charge.
VOLC_SEARCH_FREE_ONLY_VERIFIED=false
VOLC_SEARCH_FREE_WINDOW_START=
VOLC_SEARCH_FREE_WINDOW_END=
VOLC_SEARCH_FREE_BUDGET=0
# ISO 8601 start/end must include an explicit timezone. No automatic quota reset.
# VOLC_SEARCH_USAGE_PATH=D:/guet-agent-微调/run/volc_search_usage.json
